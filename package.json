{
  "name": "calendrier-cn-fr",
  "private": true,
  "version": "0.0.0",
  "description": "Calendrier franco-chinois : jours fériés, jours de rattrapage, calendrier lunaire et 24 termes solaires.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:cn": "node scripts/sync-cn-holidays.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "idb": "^8.0.4",
    "preact": "^11.0.1",
    "tyme4ts": "^1.5.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
